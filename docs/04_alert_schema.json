{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UnifiedDraftAlertSchema",
  "type": "object",
  "required": [
    "alert_id",
    "timestamp",
    "flow_id",
    "threat_class",
    "severity",
    "confidence",
    "source",
    "destination",
    "supporting_evidence",
    "detector",
    "model_version",
    "schema_version"
  ],
  "properties": {
    "alert_id": {
      "type": "string",
      "description": "Unique UUID for the draft alert"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of detection"
    },
    "flow_id": {
      "type": "string",
      "description": "Identifier for the flow or window"
    },
    "threat_class": {
      "type": "string",
      "enum": [
        "reconnaissance",
        "scanning",
        "ddos",
        "beaconing",
        "dga",
        "dga_dns",
        "dns_tunnel",
        "tls_anomaly",
        "exfiltration",
        "anomalous_behavior"
      ],
      "description": "Normalized threat classification"
    },
    "severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "description": "Detector-level initial severity"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Detector confidence in [0.0, 1.0]"
    },
    "source": {
      "type": "string",
      "description": "Source IP address or identifier"
    },
    "destination": {
      "type": "string",
      "description": "Destination IP address"
    },
    "supporting_evidence": {
      "type": "object",
      "minProperties": 1,
      "description": "Deterministic measurements and native evidence"
    },
    "detector": {
      "type": "string",
      "description": "Detector name identifier"
    },
    "model_version": {
      "type": "string",
      "description": "Detector / model version string"
    },
    "detector_version": {
      "type": "string",
      "description": "Alias for model_version maintained for backward compatibility"
    },
    "schema_version": {
      "type": "string",
      "description": "Alert contract schema version, e.g. 1.0.0"
    },
    "subtype": {
      "type": "string",
      "description": "Optional attack subtype, e.g. port_scan, address_scan, syn_flood"
    },
    "asset_criticality": {
      "type": "string",
      "description": "Optional OT asset criticality level"
    },
    "correlated_alert_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional list of correlated alert UUIDs"
    },
    "latency_class": {
      "type": "string",
      "enum": [
        "event_driven",
        "periodic"
      ],
      "description": "Processing path: event_driven or periodic"
    }
  },
  "additionalProperties": true
}
